{
  "name": "time-tracking-company-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "docker:build:prod": "docker build --platform linux/arm64 --target prod --build-arg VITE_BASE_URL=$VITE_BASE_URL --build-arg VITE_GMAP_API_KEY=$VITE_GMAP_API_KEY -t alphatrack888/time-tracking-company-dashboard:latest .",
    "docker:push": "docker push alphatrack888/time-tracking-company-dashboard:latest",
    "docker:release": "npm run docker:build:prod && npm run docker:push"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.1.0",
    "@mui/x-date-pickers": "^8.5.3",
    "@mui/x-date-pickers-pro": "^8.5.3",
    "@react-google-maps/api": "^2.20.7",
    "@reduxjs/toolkit": "^2.8.2",
    "@tailwindcss/vite": "^4.1.5",
    "axios": "^1.11.0",
    "dayjs": "^1.11.18",
    "jodit-react": "^5.2.19",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-dropzone": "^14.3.8",
    "react-icons": "^5.5.0",
    "react-otp-input": "^3.1.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.5.3",
    "react-slick": "^0.30.3",
    "recharts": "^2.15.3",
    "slick-carousel": "^1.8.1",
    "sonner": "^2.0.3",
    "tailwindcss": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "vite": "^6.3.5"
  }
}
